{
  "name": "family-roots",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:rules": "node scripts/run-rules-tests.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "vitest run src/components/ui",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:a11y && npm run test:rules",
    "check:full": "npm run check && npm run test:e2e",
    "generate:join-parent-golden": "tsx scripts/generate-join-parent-golden.mjs",
    "export:layout-canvas": "tsx scripts/export-layout-canvas-data.mjs",
    "open:layout-gallery": "cursor ../canvases/layout-scenario-gallery.canvas.tsx",
    "preview": "vite preview",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy": "npm run check && npm run build && firebase deploy"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.10",
    "elkjs": "^0.10.0",
    "firebase": "^12.18.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
