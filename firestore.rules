rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function family(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isEditor(familyId) {
      return request.auth != null
        && request.auth.uid in family(familyId).get('editorUids', []);
    }

    function isListedEditor() {
      return request.auth != null
        && request.auth.uid in resource.data.get('editorUids', []);
    }

    function isClaimingInvite(familyId) {
      return request.auth != null
        && request.auth.token.email.lower() in family(familyId).get('pendingInviteEmails', []);
    }

    function validRelationshipType(t) {
      return t == 'spouse' || t == 'parent_child';
    }

    function validConfidence(c) {
      return c == 'imported' || c == 'manual' || c == 'low';
    }

    function familyFieldsUnchanged() {
      return request.resource.data.name == resource.data.name
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.viewKey == resource.data.viewKey;
    }

    function pendingInviteKeys(data) {
      return data.pendingInvites == null ? [] : data.pendingInvites.keys();
    }

    function removedInviteToken() {
      let oldKeys = pendingInviteKeys(resource.data);
      let newKeys = pendingInviteKeys(request.resource.data);
      return oldKeys.hasAll(newKeys)
        && oldKeys.size() == newKeys.size() + 1
        ? oldKeys.toSet().difference(newKeys.toSet()).toList()[0]
        : null;
    }

    function removedInviteMatchesEmail(token) {
      let invite = resource.data.pendingInvites[token];
      return invite.type == 'open'
        || (invite.type == 'email'
          && invite.email == request.auth.token.email.lower());
    }

    function isValidInviteClaim(familyId) {
      return isClaimingInvite(familyId)
        && request.auth.uid in request.resource.data.editorUids
        && request.resource.data.editorUids.size() == resource.data.editorUids.size() + 1
        && request.resource.data.get('pendingInviteEmails', []).size()
          == resource.data.get('pendingInviteEmails', []).size() - 1
        && request.resource.data.pendingInvites == resource.data.pendingInvites
        && familyFieldsUnchanged();
    }

    function isValidInviteTokenClaim(familyId) {
      let token = removedInviteToken();
      return request.auth != null
        && token != null
        && request.auth.uid in request.resource.data.editorUids
        && request.resource.data.editorUids.size() == resource.data.editorUids.size() + 1
        && request.resource.data.get('pendingInviteEmails', [])
          == resource.data.get('pendingInviteEmails', [])
        && removedInviteMatchesEmail(token)
        && familyFieldsUnchanged();
    }

    match /families/{familyId} {
      allow get: if true;
      allow list: if isListedEditor();
      allow create: if request.auth != null
        && request.resource.data.slug == familyId
        && request.resource.data.editorUids.size() == 1
        && request.auth.uid in request.resource.data.editorUids
        && request.resource.data.pendingInviteEmails.size() == 0
        && request.resource.data.viewKey is string
        && request.resource.data.viewKey.size() > 0
        && request.resource.data.pendingInvites.keys().size() == 0;
      allow update: if isEditor(familyId)
        || isValidInviteClaim(familyId)
        || isValidInviteTokenClaim(familyId);
      allow delete: if isEditor(familyId);
    }

    match /people/{personId} {
      allow read: if true;
      allow create: if isEditor(request.resource.data.familyId)
        && request.resource.data.familyId is string;
      allow update: if isEditor(request.resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId;
      allow delete: if isEditor(resource.data.familyId);
    }

    match /userEdits/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /relationships/{relationshipId} {
      allow read: if true;
      allow create: if isEditor(request.resource.data.familyId)
        && request.resource.data.familyId is string
        && validRelationshipType(request.resource.data.type)
        && validConfidence(request.resource.data.confidence)
        && request.resource.data.personAId != request.resource.data.personBId;
      allow update: if isEditor(request.resource.data.familyId)
        && request.resource.data.familyId == resource.data.familyId
        && validRelationshipType(request.resource.data.type)
        && validConfidence(request.resource.data.confidence)
        && request.resource.data.personAId != request.resource.data.personBId;
      allow delete: if isEditor(resource.data.familyId);
    }
  }
}
